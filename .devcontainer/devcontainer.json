{
  "name": "puducherry-vanet-transfer",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "containerEnv": {
    "SUMO_HOME": "/usr/share/sumo",
    "PYTHONPATH": "/workspaces/puducherry-vanet-transfer"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit dashboard", "onAutoForward": "notify" }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
